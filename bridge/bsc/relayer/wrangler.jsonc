// The bridge for both networks, one Worker (settings in worker/networks.js):
//   mainnet-bridge.ama.one = mainnet, testnet-bridge.ama.one = testnet, `npm run dev` = DEV_NETWORK.
// Secrets: MAINNET_PRIVATE_KEY, TESTNET_PRIVATE_KEY. Each is that network's relay key on BSC; its
// Amadeus key is derived from it (src/core.js amadeusSeedOf).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ama-bridge",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run build" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [
    { "pattern": "mainnet-bridge.ama.one", "custom_domain": true },
    { "pattern": "testnet-bridge.ama.one", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html"] },
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }],
  "vars": { "DEV_NETWORK": "testnet" }
}
