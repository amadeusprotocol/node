#one file for the bridge tools (bridge/.env, gitignored)
#relay key of the network (BSC/EVM key; the relay's Amadeus key is derived from it)
PRIVATE_KEY=0x
#forge deploys (run from bridge/evm after `set -a; . ../.env; set +a`)
BRIDGE_ADMIN=0x
TRUST=deploy/amadeus-testnet.json
#optional for a redeploy: keep a light client (LAST_NONCE is not needed: Amadeus keys receipts by contract)
LIGHT_CLIENT=
LAST_NONCE=
